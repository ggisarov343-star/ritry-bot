import os, telebot, yt_dlp, threading, re, time
from telebot import types

TOKEN = os.getenv("BOT_TOKEN")
bot = telebot.TeleBot(TOKEN)
last_url = {}

def get_url(t):
    m = re.search(r'https?://\S+', t)
    return m.group(0).split()[0] if m else None

def download(cid, url, mode):
    unique = f"v_{cid}_{int(time.time())}"
    fmt = "22/18/best" if "720" in mode else "18/worst" if "360" in mode else "bestaudio"
    opts = {'format': fmt, 'outtmpl': f"{unique}.%(ext)s", 'noplaylist': True, 'quiet': True, 'nocheckcertificate': True, 'overwrites': True, 'extractor_args': {'youtube': {'player_client': ['android']}}}
    try:
        bot.send_message(cid, f"⏳ Качаю {mode}...")
        with yt_dlp.YoutubeDL(opts) as ydl:
            ydl.download([url])
        for f in os.listdir('.'):
            if f.startswith(unique):
                if "v" in mode:
                    bot.send_video(cid, open(f,'rb'), caption=f"🎬 {mode}")
                else:
                    bot.send_audio(cid, open(f,'rb'), caption=f"🎵 Музыка")
                os.remove(f)
                return
    except Exception as e:
        bot.send_message(cid, f"❌ {e}")

@bot.message_handler(func=lambda m: m.text and ("youtu" in m.text.lower() or "gram" in m.text.lower()))
def links(m):
    url = get_url(m.text)
    last_url[m.chat.id] = url
    kb = types.InlineKeyboardMarkup(row_width=2)
    kb.add(types.InlineKeyboardButton("🎥 720p", callback_data="720v"), types.InlineKeyboardButton("📱 360p", callback_data="360v"), types.InlineKeyboardButton("🎵 MP3", callback_data="mp3"), types.InlineKeyboardButton("🎬 В Галерею", callback_data="360v"))
    bot.send_message(m.chat.id, f"Что сохранить?\n{url}", reply_markup=kb)

@bot.callback_query_handler(func=lambda c: c.data in ["720v","360v","mp3"])
def cb(c):
    url = last_url.get(c.message.chat.id)
    threading.Thread(target=download, args=(c.message.chat.id, url, c.data)).start()
    bot.answer_callback_query(c.id, f"Качаю {c.data}")

@bot.message_handler(func=lambda m: True)
def hi(m):
    if m.text and m.text.lower().strip() in ["привет","салам"]:
        bot.send_message(m.chat.id, "Привет! Кидай ссылку!")

print("Бот 24/7 готов!")
bot.infinity_polling()